# Vendored third-party code, fetched by setup_environment.py.
# ~211 MB: the PSpred clone (with its trained models) and the patched
# metapredict source. Both are reproducible from setup_environment.py, so they
# are deliberately not tracked.
vendor/

# Virtual environments. These live outside the package by default (see the
# ENV_ROOT note in paths.py -- torch blows past Windows' MAX_PATH from a long
# project path), but ignore them in case someone points EXPANSION_ENVS here.
envs/
.venv/
venv/
.env/

# Rebuild work directories and manually staged source directories.
rebuild_output/
sources/
source-data/
manual_sources/
data/

# Per-family intermediates. Hundreds of MB, fully regenerable by run_all.py,
# and by default written to a temp directory rather than here.
intermediates/
*.pkl
*.parquet
*.arrow
*.feather
*.sqlite
*.sqlite3

# Downloaded biological sequence/annotation artifacts.
*.fasta
*.fa
*.faa
*.fna
*.dat
*.gtf
*.gff
*.gff3
*.bed
*.bed.gz
*.tsv.gz
*.zip
*.tar
*.tar.gz

# Named large/manual sources used by the clean rebuild.
9606.protein.links*.txt
df_np_unique.interpro.tsv
df_ptm.csv
rbp_master_with_eclip.csv
condensates.csv
MISSING.csv
CD-CODE_Files/

# Generated outputs. These belong next to the data, not in the repo.
reports/
report_manifest.json
Missing_Proteins_Rows.csv
*_Extended.csv
*_Expanded.csv
New_Columns_Documentation.csv
Human_Proteome_RCSB_PDB_Summary.csv
Human_Proteome_RCSB_Secondary_Structure.csv.gz
Human_Proteome_RCSB_Secondary_Structure.metadata.json
*_Extended_RCSB.csv
human_proteome_isoforms_features.csv
human_proteome_isoforms_features.csv.manifest.json

__pycache__/
*.py[cod]
.ipynb_checkpoints/
.DS_Store
Thumbs.db
